# splash configuration reference.
#
# Copy this to .env and edit it, or set these variables in your shell, container
# or platform. The service reads the process environment directly — there is no
# .env loader, because a container runtime already provides one. To use this
# file locally:
#
#   set -a; source .env; set +a; go run ./cmd/server     # bash / zsh
#   Get-Content .env | Where-Object {$_ -match '='} | ForEach-Object { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim()) }
#
# Every variable has a working default, so an empty environment is a valid
# configuration. Command-line flags override all of these.

# development | test | production.
# Production also switches the log format default to json.
SPLASH_ENV=development

# host:port. Use :0 in tests to get an ephemeral port.
SPLASH_HTTP_ADDR=:8080

# --- timeouts ---
# ReadTimeout covers the whole request including the body.
SPLASH_READ_TIMEOUT=15s
# ReadHeaderTimeout is the one that protects against slowloris.
SPLASH_READ_HEADER_TIMEOUT=5s
SPLASH_WRITE_TIMEOUT=30s
SPLASH_IDLE_TIMEOUT=90s
# Grace period for in-flight requests during a rolling restart.
SPLASH_SHUTDOWN_TIMEOUT=20s

# --- limits ---
# Hard cap is 32 MiB; Validate() rejects anything larger.
SPLASH_MAX_REQUEST_BODY_BYTES=1048576

# --- logging ---
# text | json. Production defaults to json when this is unset.
SPLASH_LOG_FORMAT=text
# debug | info | warn | error
SPLASH_LOG_LEVEL=info
# Optional second sink. Always JSON, driven alongside stdout by one
# slog.MultiHandler. The directory is created if missing.
# SPLASH_LOG_FILE=/var/log/splash/app.log
# Add file and line to every record. Useful locally, noisy in production.
SPLASH_LOG_SOURCE=false

# --- CORS ---
# Unset means no CORS headers at all, which is correct for same-origin
# deployments and for local development (Vite proxies /api, so the browser only
# ever sees one origin).
# Comma-separated. "*" is allowed but cannot be combined with explicit origins,
# and it never enables credentials.
# SPLASH_CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
# How long a browser may cache a preflight. Unset omits the header.
# SPLASH_CORS_MAX_AGE=10m

# --- diagnostics ---
# Mounts /debug/pprof/, including the Go 1.27 goroutineleak profile.
# Profiles expose memory contents and cost CPU to generate: never enable this on
# an interface the public can reach.
SPLASH_ENABLE_PPROF=false

# --- authentication ---
# The single administrator account. Every page and every API read requires
# this login; there is no anonymous access. CHANGE BOTH before exposing the
# service to anyone else.
SPLASH_ADMIN_USERNAME=admin
SPLASH_ADMIN_PASSWORD=splash123
# Signs session cookies (HMAC-SHA256). Any string of 16..256 characters.
# Rotating it invalidates every issued session. The shipped default is public
# knowledge, so production boots warn until it is replaced.
SPLASH_AUTH_SECRET=splash-dev-secret-change-me
# IDLE timeout of a login (1h..720h). Any authenticated request slides it
# forward, and open editing surfaces send a quiet heartbeat — so an active
# session never expires mid-edit; only this much silence ends it.
# The cookie itself is browser-session scoped: closing the browser always
# forces a fresh login, regardless of this value.
SPLASH_SESSION_TTL=24h
# Mark the session cookie Secure when serving over HTTPS. Leave false for
# plain-HTTP local development or the browser will not send the cookie back.
SPLASH_COOKIE_SECURE=false

# --- storage ---
# SQLite database file. The parent directory is created at startup. The
# container image sets /data/splash.db on a volume; ":memory:" keeps everything
# in process memory (tests do this).
SPLASH_DB_PATH=data/splash.db

# --- demo data ---
# Insert sample categories, projects and ~120 days of history into an EMPTY
# database at startup, so a first run has something to look at. Never touches
# a database that already has projects. The -seed flag does the same.
SPLASH_SEED_DEMO=false

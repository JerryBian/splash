# Line endings.
#
# Development happens on Windows and CI runs on Linux, so this is not cosmetic:
# without it, a shell script or Makefile checked out with CRLF fails in
# unpredictable ways, and diffs fill with invisible changes.
#
# `text=auto` lets git normalise on check-in; `eol=lf` pins what lands in the
# working tree for the formats that care.
* text=auto eol=lf

# Executables and interpreted files must be LF regardless of platform.
*.sh          text eol=lf
*.mjs         text eol=lf
*.js          text eol=lf
Makefile      text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# Source and docs.
*.go          text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.css         text eol=lf
*.html        text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.svg         text eol=lf

# Never touch binaries or generated lockfiles.
*.png         binary
*.jpg         binary
*.ico         binary
*.woff        binary
*.woff2       binary
*.gz          binary
*.zip         binary

# The lockfile is generated by pnpm and must round-trip byte for byte, or
# `--frozen-lockfile` fails for reasons nobody can see in the diff.
pnpm-lock.yaml text eol=lf -diff
